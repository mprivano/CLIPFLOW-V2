# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Required for AI clip transcript suggestions.
# Configure this in your AI Studio Secrets panel.
OPENAI_API_KEY=""

# VIZARDAI_API_KEY: Required for Vizard API social syncing features.
# Configure this in your AI Studio Secrets panel.
VIZARDAI_API_KEY=""

# Google Drive JSON mode: preferred over browser Google sign-in.
# Option A: put the full service account file at ./google-service-account.json.
# Option B: paste the full JSON into this env var on one line.
GDRIVE_SERVICE_ACCOUNT_JSON=""

# Optional: default Google Drive folder ID for JSON mode.
GDRIVE_FOLDER_ID="root"

# TIKTOK_CLIENT_KEY & TIKTOK_CLIENT_SECRET: For direct TikTok API uploading.
# Configure this in your AI Studio Secrets panel.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Optional: required for real TikTok Content Posting API calls from server env.
TIKTOK_ACCESS_TOKEN=""

# Optional: server-side fallback Telegram bot credentials.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
